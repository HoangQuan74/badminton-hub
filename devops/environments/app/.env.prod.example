APP_ENV=prod
API_IMAGE=ghcr.io/your-github-user/badminton-hub-api
IDENTITY_IMAGE=ghcr.io/your-github-user/badminton-hub-identity
WEB_IMAGE=ghcr.io/your-github-user/badminton-hub-web
IMAGE_TAG=replace-with-git-sha
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=80

IDENTITY_DATABASE_URL=postgres://badminton_hub:replace-me@10.0.0.10:5432/badminton_identity_prod?sslmode=disable
IDENTITY_REDIS_URL=redis://:replace-me@10.0.0.10:6379/1
GATEWAY_REDIS_URL=redis://:replace-me@10.0.0.10:6379/0
MONGODB_URI=mongodb://badminton_hub:replace-me@10.0.0.10:27017/?authSource=admin
MONGODB_DATABASE=badminton_hub_prod

IDENTITY_JWT_SECRET=replace-with-at-least-32-random-characters
IDENTITY_ACCESS_TOKEN_TTL=15m
IDENTITY_REFRESH_TOKEN_TTL=168h
