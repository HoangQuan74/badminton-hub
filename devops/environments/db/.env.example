POSTGRES_IDENTITY_DEV_DB=badminton_identity_dev
POSTGRES_IDENTITY_PROD_DB=badminton_identity_prod
POSTGRES_USER=badminton_hub
POSTGRES_PASSWORD=replace-with-a-strong-password
REDIS_PASSWORD=replace-with-a-strong-password
MONGO_ROOT_USER=badminton_hub
MONGO_ROOT_PASSWORD=replace-with-a-strong-password
