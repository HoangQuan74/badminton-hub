APP_ENV=local
GATEWAY_REDIS_URL=redis://localhost:16380/0

CONSUMER_KAFKA_BROKERS=localhost:19093
CONSUMER_KAFKA_CLIENT_ID=badminton-hub-consumer
CONSUMER_KAFKA_GROUP_ID=badminton-hub-consumer
CONSUMER_KAFKA_DIAL_TIMEOUT=5s
CONSUMER_KAFKA_READ_TIMEOUT=10s
CONSUMER_KAFKA_WRITE_TIMEOUT=10s

USER_GATEWAY_HTTP_ADDR=:8081
USER_GATEWAY_IDENTITY_GRPC_TARGET=127.0.0.1:9091
USER_GATEWAY_SHUTDOWN_TIMEOUT=10s
USER_GATEWAY_DEPENDENCY_TIMEOUT=5s

ADMIN_GATEWAY_HTTP_ADDR=:8082
ADMIN_GATEWAY_IDENTITY_GRPC_TARGET=127.0.0.1:9091
ADMIN_GATEWAY_SHUTDOWN_TIMEOUT=10s
ADMIN_GATEWAY_DEPENDENCY_TIMEOUT=5s

SOCKET_GATEWAY_HTTP_ADDR=:8083
SOCKET_GATEWAY_GRPC_TARGET=127.0.0.1:9093
SOCKET_GRPC_ADDR=:9093
SOCKET_JWT_SECRET=replace-with-at-least-32-random-characters
SOCKET_REDIS_URL=redis://localhost:16379/2
SOCKET_REDIS_CHANNEL=badminton:realtime
SOCKET_GATEWAY_SHUTDOWN_TIMEOUT=10s
SOCKET_GATEWAY_DEPENDENCY_TIMEOUT=5s

IDENTITY_DATABASE_URL=postgres://postgres:postgres@localhost:15432/badminton_identity?sslmode=disable
IDENTITY_REDIS_URL=redis://localhost:16379/1
IDENTITY_JWT_SECRET=replace-with-at-least-32-random-characters
IDENTITY_ACCESS_TOKEN_TTL=15m
IDENTITY_REFRESH_TOKEN_TTL=168h
IDENTITY_SHUTDOWN_TIMEOUT=10s
IDENTITY_DATABASE_PING_TIMEOUT=5s
IDENTITY_DEPENDENCY_TIMEOUT=5s
