{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://badmintonhub.local/contracts/events/envelope.v1.json",
  "title": "BadmintonHub event envelope v1",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "aggregate_id",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+\\.v[0-9]+$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "organization_id": {"type": ["string", "null"], "format": "uuid"},
    "aggregate_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "minLength": 1},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
